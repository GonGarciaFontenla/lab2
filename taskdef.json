{
  "family": "frontend-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["EC2"],
  "executionRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "frontend",
      "image": "<IMAGE1_NAME>",
      "essential": true,
      "cpu": 256,
      "memory": 512,
      "portMappings": [
        { "containerPort": 3000, "protocol": "tcp" }
      ],
      "environment": [
        { "name": "PORT", "value": "3000" },
        { "name": "MYSQL_SSL", "value": "false" }
      ],
      "secrets": [
        { "name": "MYSQL_HOST",     "valueFrom": "arn:aws:ssm:us-east-1:<ACCOUNT_ID>:parameter/lab2/db/host" },
        { "name": "MYSQL_USER",     "valueFrom": "arn:aws:ssm:us-east-1:<ACCOUNT_ID>:parameter/lab2/db/user" },
        { "name": "MYSQL_PASSWORD", "valueFrom": "arn:aws:ssm:us-east-1:<ACCOUNT_ID>:parameter/lab2/db/password" },
        { "name": "MYSQL_DATABASE", "valueFrom": "arn:aws:ssm:us-east-1:<ACCOUNT_ID>:parameter/lab2/db/name" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/frontend-task",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "frontend"
        }
      }
    }
  ]
}
